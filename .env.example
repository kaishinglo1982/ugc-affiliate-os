# Database (PostgreSQL)
DATABASE_URL=

# Session signing/encryption secret. Generate with: openssl rand -base64 48
AUTH_SECRET=

# CarryOS integration mode. STANDALONE keeps the local single-workspace path;
# CORE_BOUND requires verified CarryOS tenant + role + ServicePrincipal bindings.
CARRYOS_INTEGRATION_MODE=STANDALONE

# CarryOS tenant assertion verification secret. Must differ from AUTH_SECRET.
# In production UGC verifies assertions only; it never mints them.
CARRYOS_TENANT_SECRET=

# CarryOS Tenant UUID -> local UGC Workspace UUID.
CARRYOS_TENANT_WORKSPACE_BINDINGS_JSON=

# Local Workspace UUID -> { local User UUID -> explicit UGC role }.
CARRYOS_WORKSPACE_ROLE_BINDINGS_JSON=

# Canonical CarryOS UGC runtime contract.
CARRYOS_API_URL=
CARRYOS_UGC_EXECUTE_PATH=/api/v1/plugins/ugc/execute
CARRYOS_UGC_CONTRACT_VERSION=2026-09-16.v1

# CarryOS Tenant UUID -> tenant-bound ServicePrincipal credential.
# Never commit real credentials and never expose this value to browser code.
CARRYOS_UGC_SERVICE_PRINCIPAL_BINDINGS_JSON=

# Public app URL, used for absolute links (emails, OG, sitemaps)
APP_URL=
APP_BASE_URL=

# Stable workspace id for STANDALONE/single-workspace installs only.
DEFAULT_WORKSPACE_ID=

# Single-user admin bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Bearer token for cron/worker endpoints.
WORKER_SECRET=

# AES-256-GCM master key for provider credentials at rest.
CREDENTIAL_ENCRYPTION_KEY=

# 21st.dev component/design API key (build/design time only)
API_KEY_21ST=

# Direct LLM provider keys are standalone-only routing inputs. In CORE_BOUND
# mode script generation routes through CarryOS Core instead.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Video/voice domain connectors
HIGGSFIELD_API_KEY=
ELEVENLABS_API_KEY=

# S3-compatible media storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
