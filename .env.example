# Database (PostgreSQL)
DATABASE_URL=

# Session signing/encryption secret. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Tenancy mode must be explicit in production:
# SINGLE_TENANT = one private workspace; CORE_BOUND = authenticated CarryOS tenants.
# Local development may leave this unset and use the default workspace.
CARRYOS_INTEGRATION_MODE=

# CarryOS tenant-token signing secret. Must differ from AUTH_SECRET.
# Generate with: openssl rand -base64 48
CARRYOS_TENANT_SECRET=

# Required in CORE_BOUND mode: JSON map of CarryOS tenant UUID -> UGC workspace UUID.
# Example: {"11111111-1111-4111-8111-111111111111":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"}
CARRYOS_TENANT_WORKSPACE_BINDINGS_JSON=

# Required in CORE_BOUND mode: JSON map of workspace UUID -> user UUID -> role.
# Example: {"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa":{"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb":"admin"}}
CARRYOS_WORKSPACE_ROLE_BINDINGS_JSON=

# Public app URL, used for absolute links (emails, OG, sitemaps)
APP_URL=

# Base URL used by external cron shell scripts. Usually the same as APP_URL.
APP_BASE_URL=

# Optional stable workspace id for single-workspace installs.
DEFAULT_WORKSPACE_ID=

# Single-user admin account. Set ADMIN_PASSWORD_HASH for production (bcrypt hash,
# see README "Login-Erstellung"). ADMIN_PASSWORD is a development-only convenience:
# if ADMIN_PASSWORD_HASH is empty, the seed script will hash ADMIN_PASSWORD for you.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Bearer token for cron/worker endpoints. Generate with: openssl rand -base64 48
WORKER_SECRET=

# AES-256-GCM master key for encrypting provider credentials at rest (64 hex chars / 32 bytes).
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# 21st.dev component/design API key (used at build/design time only, never shipped to client)
API_KEY_21ST=

# LLM providers for the UGC Script Studio (optional — local template mode works without any of these)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# HuggingFace (Inference Providers / Serverless Inference). Example: hf_xxxxxxxxxxxxxxxxxxxx
HUGGINGFACE_API_KEY=

# Video/voice providers for the Video Studio (optional — mock provider works without these)
HIGGSFIELD_API_KEY=
ELEVENLABS_API_KEY=

# S3-compatible object storage for the Media Library (optional — local dev storage is used without these)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
