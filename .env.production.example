# =====================================================================
# UGC Affiliate OS – Vercel Production Environment
# Scope: current master runtime contract. CORE_BOUND audit-branch variables
# are NOT promoted here until that integration code reaches the mainline.
# Never commit real secrets; configure production values outside Git.
# Production deploy remains blocked until the GitHub 10/10 gate is green.
# A Vercel Preview status is not release evidence and must not replace CI.
# =====================================================================

# Database
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Session/auth signing
AUTH_SECRET=<set-in-vercel-environment-min-32-chars>

# CarryOS tenant assertion used by the current master integration path.
# Keep separate from AUTH_SECRET.
CARRYOS_TENANT_SECRET=<set-only-when-carryos-tenant-assertion-is-enabled>

# Public application URLs
APP_URL=https://<ugc-domain>
APP_BASE_URL=https://<ugc-domain>

# Current standalone/single-workspace compatibility.
DEFAULT_WORKSPACE_ID=

# Admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=<bcrypt-hash-if-bootstrap-is-used>
# Production: leave ADMIN_PASSWORD empty; prefer ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=

# Worker / cron endpoint authentication
WORKER_SECRET=<set-in-vercel-environment-min-32-chars>
CRON_SECRET=<set-in-vercel-environment-min-32-chars>

# AES-256-GCM provider credential encryption
CREDENTIAL_ENCRYPTION_KEY=<64-hex-chars>

# Optional build/design provider
API_KEY_21ST=

# Optional direct LLM providers on current master
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Optional video / voice providers
HIGGSFIELD_API_KEY=
ELEVENLABS_API_KEY=

# Optional S3-compatible media storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=

# Intentionally excluded from current-master Vercel Production:
# E2E_BASE_URL / E2E_EMAIL / E2E_PASSWORD (CI only)
# CARRYOS_INTEGRATION_MODE (audit/companion branch only today)
# CARRYOS_TENANT_WORKSPACE_BINDINGS_JSON (audit/companion branch only today)
# CARRYOS_WORKSPACE_ROLE_BINDINGS_JSON (audit/companion branch only today)
# CARRYOS_API_URL / global CarryOS service-token experiments
