# =====================================================================
# UGC Affiliate OS – Production Environment Contract
# Never commit real secrets. Production deploy remains blocked until the
# global CarryOS Universe GitHub 10/10 gate is green.
# =====================================================================

# Database
DATABASE_URL=postgresql://<runtime-user>:<password>@<host>/<database>?sslmode=require

# Session/auth signing
AUTH_SECRET=<set-in-runtime-min-32-chars>

# Public application URLs
APP_URL=https://<ugc-domain>
APP_BASE_URL=https://<ugc-domain>

# CarryOS integration. Production uses CORE_BOUND after the global gate.
CARRYOS_INTEGRATION_MODE=CORE_BOUND

# Short-lived CarryOS tenant assertion verification secret. Separate from
# AUTH_SECRET. UGC verifies assertions; it must not mint them in production.
CARRYOS_TENANT_SECRET=<set-in-runtime-min-32-chars>

# CarryOS Tenant UUID -> local UGC Workspace UUID.
# Example shape only; use real bindings outside Git:
# {"11111111-1111-4111-8111-111111111111":"00000000-0000-4000-8000-000000000001"}
CARRYOS_TENANT_WORKSPACE_BINDINGS_JSON=<server-only-json>

# Local Workspace UUID -> { local User UUID -> explicit role }.
# Missing mappings fail closed in CORE_BOUND mode; there is no implicit owner.
CARRYOS_WORKSPACE_ROLE_BINDINGS_JSON=<server-only-json>

# Canonical CarryOS UGC runtime contract (CarryOS PR #183).
CARRYOS_API_URL=https://<carryos-domain>
CARRYOS_UGC_EXECUTE_PATH=/api/v1/plugins/ugc/execute
CARRYOS_UGC_CONTRACT_VERSION=2026-09-16.v1

# CarryOS Tenant UUID -> tenant-bound UGC ServicePrincipal credential.
# Each credential must belong to pluginId/appId=ugc-affiliate-os with an active
# PluginInstallation, entitlement, scope carryos:workflow:execute and capability
# ugc:runtime:execute. Server-only. Never expose to browsers.
CARRYOS_UGC_SERVICE_PRINCIPAL_BINDINGS_JSON=<server-only-json>

# Standalone compatibility only; ignored as authority in CORE_BOUND mode.
DEFAULT_WORKSPACE_ID=

# Admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=<bcrypt-hash-if-bootstrap-is-used>
# Production: leave ADMIN_PASSWORD empty; prefer ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=

# Creator Revenue OS -> UGC Affiliate OS service authentication.
UGC_SERVICE_TOKEN=<set-in-runtime-min-32-chars>

# Explicit local workspace bound to the Creator Revenue service principal.
# Required in CORE_BOUND mode; never accepted from caller headers.
UGC_CREATOR_REVENUE_WORKSPACE_ID=<workspace-uuid>

# Worker / cron endpoint authentication
WORKER_SECRET=<set-in-runtime-min-32-chars>
CRON_SECRET=<set-in-runtime-min-32-chars>

# AES-256-GCM provider credential encryption
CREDENTIAL_ENCRYPTION_KEY=<64-hex-chars>

# Optional build/design provider
API_KEY_21ST=

# Direct LLM providers are NOT runtime routing authority in CORE_BOUND mode.
# Keep these unset in CarryOS-bound production unless a separate connector path
# is explicitly governed. Script generation routes through CarryOS Core.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Domain video / voice connectors
HIGGSFIELD_API_KEY=
ELEVENLABS_API_KEY=

# S3-compatible media storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=

# CI-only variables intentionally excluded from Production:
# E2E_BASE_URL, E2E_EMAIL, E2E_PASSWORD, DATABASE_URL_TEST.
# Legacy global CarryOS shared tokens are intentionally excluded.
