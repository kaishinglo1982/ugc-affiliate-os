// ---------------------------------------------------------------------------
// Experimentation
// ---------------------------------------------------------------------------

model ContentExperiment {
  id                            String              @id @default(uuid())
  workspaceId                   String
  brandId                       String
  name                          String
  description                   String?
  experimentType                ExperimentType
  status                        ExperimentStatus    @default(DRAFT)
  primaryMetric                 ExperimentMetric
  secondaryMetrics              ExperimentMetric[]
  minimumSampleSize             Int
  minimumRuntimeHours           Int
  maximumRuntimeHours           Int
  confidenceThreshold           Decimal             @db.Decimal(4, 3)
  practicalSignificanceThreshold Decimal            @db.Decimal(14, 4)
  trafficAllocationMode         TrafficAllocationMode @default(EQUAL)
  approvalStatus                ApprovalStatus      @default(DRAFT)
  startedAt                     DateTime?
  endedAt                       DateTime?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt

  variants                      ExperimentVariant[]
  assignments                   ExperimentAssignment[]
  results                       ExperimentResult[]

  @@index([workspaceId, status])
  @@index([brandId])
}

model ExperimentVariant {
  workspaceId String
  id                      String                  @id @default(uuid())
  experimentId            String
  contentVariantId        String?
  publishingConfigurationId String?
  name                    String
  isControl               Boolean                 @default(false)
  trafficWeight           Int
  status                  ExperimentVariantStatus @default(DRAFT)
  createdAt               DateTime                @default(now())

  experiment              ContentExperiment       @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  contentVariant          ContentVariant?         @relation(fields: [contentVariantId], references: [id])
  assignments             ExperimentAssignment[]

  @@index([experimentId])

  @@index([workspaceId])
}

model ExperimentAssignment {
  id                  String                  @id @default(uuid())
  workspaceId         String
  experimentId        String
  experimentVariantId String
  assignmentKey       String
  assignmentType      ExperimentAssignmentType
  assignmentReferenceId String
  assignedAt          DateTime                @default(now())

  experiment          ContentExperiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant             ExperimentVariant        @relation(fields: [experimentVariantId], references: [id])

  @@unique([experimentId, assignmentKey])
  @@index([workspaceId, experimentId])
  @@index([assignmentReferenceId])
}

model ExperimentResult {
  workspaceId String
  id                    String                @id @default(uuid())
  experimentId          String
  analyzedAt            DateTime              @default(now())
  status                ExperimentResultStatus
  winningVariantId      String?
  primaryMetric         ExperimentMetric
  controlValue          Decimal?              @db.Decimal(14, 4)
  winningValue          Decimal?              @db.Decimal(14, 4)
  relativeLift          Decimal?              @db.Decimal(10, 4)
  absoluteLift          Decimal?              @db.Decimal(14, 4)
  sampleSize            BigInt                @default(0)
  confidenceScore       Decimal?              @db.Decimal(4, 3)
  practicalSignificanceReached Boolean        @default(false)
  analysisMethod        AnalysisMethod        @default(FREQUENTIST)
  analysisVersion       String
  explanation           String

  experiment            ContentExperiment      @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])

  @@index([workspaceId])
}

