// UGC Affiliate Operating System — data model
// Single-user system. All monetary values use Decimal. Timestamps are UTC;
// localized display (Europe/Berlin) happens in the presentation layer.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]

  @@index([email])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Product Radar
// ---------------------------------------------------------------------------

enum ProductStatus {
  DISCOVERED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAUSED
  UNAVAILABLE
  ARCHIVED
}

enum TrendStatus {
  EMERGING
  GROWING
  STABLE
  DECLINING
  SATURATED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Product {
  id                        String        @id @default(uuid())
  workspaceId               String        @default("00000000-0000-0000-0000-000000000001")
  // Canonical Phase 7 product identity
  canonicalName             String
  slug                      String?
  description               String?
  brandName                 String?
  manufacturerName          String?
  categoryId                String?
  nicheId                   String?
  status                    ProductStatus @default(DISCOVERED)
  riskLevel                 RiskLevel     @default(MEDIUM)
  primaryImageReferenceId   String?
  languageCode              String        @default("de")
  targetCountryCodes        String[]      @default(["DE"])
  lastVerifiedAt            DateTime?
  // Legacy "Product Radar" columns retained for backward compatibility
  name                      String        @default("")
  imageUrl                  String?
  vendor                    String?
  targetUrl                 String?
  categoryLabel             String?
  tags                      String[]      @default([])
  price                     Decimal?      @db.Decimal(12, 2)
  currency                  String        @default("EUR")
  commissionRate            Decimal?      @db.Decimal(6, 3)
  estimatedMargin           Decimal?      @db.Decimal(12, 2)
  audience                  String?
  problemSolved             String?
  notes                     String?
  trend                     TrendStatus   @default(STABLE)
  risk                      RiskLevel     @default(MEDIUM)
  isFavorite                Boolean       @default(false)
  archivedAt                DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  // Relations
  category                  ProductCategory?     @relation(fields: [categoryId], references: [id])
  niche                     Niche?               @relation(fields: [nicheId], references: [id])
  primaryImage              MediaAsset?          @relation("ProductPrimaryImage", fields: [primaryImageReferenceId], references: [id])
  scores                    ProductScore[]
  affiliateLinks            AffiliateLink[]
  offers                    AffiliateOffer[]
  complianceProfiles        ProductComplianceProfile[]
  contentFitProfiles        ProductContentFitProfile[]
  profitabilityEstimates    ProductProfitabilityEstimate[]
  opportunities             ProductOpportunity[]
  dataQualityReports        ProductDataQualityReport[]
  matchCandidates           ProductMatchCandidate[] @relation("MatchSourceProduct")
  campaigns                 Campaign[]
  scripts                   Script[]
  videoJobs                 VideoJob[]
  mediaAssets               MediaAsset[]
  revenues                  Revenue[]
  expenses                  Expense[]

  @@index([workspaceId, status])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, nicheId])
  @@index([workspaceId, riskLevel])
  @@unique([workspaceId, slug])
}

model ProductScore {
  workspaceId String
  id                    String   @id @default(uuid())
  productId             String
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  demand                Int      @default(0)
  commission            Int      @default(0)
  contentPotential      Int      @default(0)
  competition           Int      @default(0)
  problemSolvingPower   Int      @default(0)
  visualDemonstrability Int      @default(0)
  platformFit           Int      @default(0)
  trendMomentum         Int      @default(0)
  returnRisk            Int      @default(0)
  complianceRisk        Int      @default(0)
  totalScore            Int      @default(0)
  breakdown             Json
  createdAt             DateTime @default(now())

  @@index([productId])

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Affiliate
// ---------------------------------------------------------------------------

enum AffiliateProviderKey {
  AMAZON_ASSOCIATES
  EBAY_PARTNER_NETWORK
  AWIN
  CJ_AFFILIATE
  IMPACT
  RAKUTEN_ADVERTISING
  SHAREASALE
  DIGISTORE24
  ADCELL
  CUSTOM
}

enum IntegrationMode {
  LIVE
  SANDBOX
  MOCK
}

model AffiliateProgram {
  workspaceId String
  id             String               @id @default(uuid())
  provider       AffiliateProviderKey
  customName     String?
  trackingId     String?
  credentialId   String?
  credential     EncryptedCredential? @relation(fields: [credentialId], references: [id])
  mode           IntegrationMode      @default(MOCK)
  status         String               @default("DISCONNECTED")
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  links    AffiliateLink[]
  revenues Revenue[]
  offers   AffiliateOffer[]

  @@index([provider])

  @@index([workspaceId])
}

model AffiliateLink {
  workspaceId String
  id               String            @id @default(uuid())
  programId        String
  program          AffiliateProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?          @relation(fields: [productId], references: [id])
  label            String
  destinationUrl   String
  deepLink         String?
  shortSlug        String            @unique
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  platform         String?
  clickCount       Int               @default(0)
  lastCheckedAt    DateTime?
  lastCheckStatus  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  clicks       LinkClick[]
  campaignLinks Campaign[]

  @@index([programId])
  @@index([productId])

  @@index([workspaceId])
}

model LinkClick {
  workspaceId String
  id        String        @id @default(uuid())
  linkId    String
  link      AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  occurredAt DateTime     @default(now())
  source    String?

  @@index([linkId])

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  RESEARCH
  SCRIPTING
  PRODUCTION
  REVIEW
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Campaign {
  workspaceId String
  id             String         @id @default(uuid())
  name           String
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id])
  affiliateLinkId String?
  affiliateLink  AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
  audience       String?
  targetPlatforms String[]      @default([])
  contentGoal    String?
  budget         Decimal?       @db.Decimal(12, 2)
  currency       String         @default("EUR")
  startDate      DateTime?
  endDate        DateTime?
  status         CampaignStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  scripts     Script[]
  videoJobs   VideoJob[]
  socialPosts SocialPost[]
  revenues    Revenue[]
  expenses    Expense[]
  mediaAssets MediaAsset[]
  briefs      ContentBrief[]
  creatorEngagements CreatorEngagement[]

  @@index([status])

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Scripts
// ---------------------------------------------------------------------------

enum ScriptStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model Script {
  workspaceId String
  id          String       @id @default(uuid())
  title       String
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id])
  campaignId  String?
  campaign    Campaign?    @relation(fields: [campaignId], references: [id])
  audience    String?
  platform    String?
  durationSec Int?
  tone        String?
  hookType    String?
  cta         String?
  status      ScriptStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  versions  ScriptVersion[]
  videoJobs VideoJob[]

  @@index([status])
  @@index([campaignId])

  @@index([workspaceId])
}

model ScriptVersion {
  workspaceId String
  id             String   @id @default(uuid())
  scriptId       String
  script         Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  versionNumber  Int
  hook           String
  problem        String
  situation      String
  productIntro   String
  demonstration  String
  benefit        String
  socialProof    String
  objectionHandling String
  cta            String
  onScreenText   String?
  bRollNotes     String?
  voiceover      String?
  sceneList      Json
  generatedBy    String   @default("template")
  createdAt      DateTime @default(now())

  @@unique([scriptId, versionNumber])

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Video
// ---------------------------------------------------------------------------

enum VideoJobStatus {
  QUEUED
  PROCESSING
  REVIEW_REQUIRED
  COMPLETED
  FAILED
  CANCELLED
}

enum VideoProviderKey {
  HIGGSFIELD
  RUNWAY
  KLING
  VEO
  HEYGEN
  ELEVENLABS
  CUSTOM
  MOCK
}

model VideoJob {
  workspaceId String
  id           String         @id @default(uuid())
  scriptId     String?
  script       Script?        @relation(fields: [scriptId], references: [id])
  productId    String?
  product      Product?       @relation(fields: [productId], references: [id])
  campaignId   String?
  campaign     Campaign?      @relation(fields: [campaignId], references: [id])
  provider     VideoProviderKey @default(MOCK)
  format       String
  aspectRatio  String
  durationSec  Int
  style        String?
  avatar       String?
  voice        String?
  language     String         @default("de")
  subtitles    Boolean        @default(true)
  music        String?
  status       VideoJobStatus @default(QUEUED)
  progress     Int            @default(0)
  errorMessage String?
  resultUrl    String?
  attempts     Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  completedAt  DateTime?

  mediaAssets MediaAsset[]

  @@index([status])
  @@index([campaignId])

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

model MediaAsset {
  workspaceId String
  id          String    @id @default(uuid())
  kind        MediaKind
  fileName    String
  storageKey  String
  url         String
  mimeType    String
  sizeBytes   Int
  durationSec Int?
  width       Int?
  height      Int?
  tags        String[]  @default([])
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  videoJobId  String?
  videoJob    VideoJob? @relation(fields: [videoJobId], references: [id])
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  socialPosts SocialPost[]

  primaryImageProducts Product[] @relation("ProductPrimaryImage")
  creatorDeliverables CreatorDeliverable[]

  @@index([kind])
  @@index([campaignId])

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Social publishing
// ---------------------------------------------------------------------------

enum SocialPlatform {
  TIKTOK
  INSTAGRAM
  FACEBOOK
  YOUTUBE_SHORTS
  PINTEREST
  REDDIT
  X
  LINKEDIN
}

model SocialAccount {
  workspaceId String
  id           String          @id @default(uuid())
  platform     SocialPlatform
  handle       String
  mode         IntegrationMode @default(MOCK)
  credentialId String?
  credential   EncryptedCredential? @relation(fields: [credentialId], references: [id])
  status       String          @default("DISCONNECTED")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  posts SocialPost[]

  @@index([platform])

  @@index([workspaceId])
}

enum SocialPostStatus {
  DRAFT
  READY
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

model SocialPost {
  workspaceId String
  id              String            @id @default(uuid())
  campaignId      String?
  campaign        Campaign?         @relation(fields: [campaignId], references: [id])
  mediaAssetId    String?
  mediaAsset      MediaAsset?       @relation(fields: [mediaAssetId], references: [id])
  accountId       String
  account         SocialAccount     @relation(fields: [accountId], references: [id])
  caption         String
  hashtags        String[]          @default([])
  affiliateLinkText String?
  disclosure      String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  status          SocialPostStatus  @default(DRAFT)
  errorMessage     String?
  attempts        Int               @default(0)
  approvedBy      String?
  approvedAt      DateTime?
  publishJobs     PublishJob[]
  impressions     Int?
  reach           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([scheduledAt])

  @@index([workspaceId])
}

enum PublishJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD
}

/**
 * Durable publish queue. One row per publish attempt for a SocialPost. The
 * worker picks PENDING jobs (and FAILED jobs whose `nextAttemptAt` has passed),
 * calls the platform adapter, and either marks the job SUCCEEDED or applies
 * exponential backoff. After `maxAttempts` failures the job is moved to DEAD
 * (dead-letter) and must be retried manually — publishing is never retried
 * indefinitely without an owner's intervention.
 */
model PublishJob {
  workspaceId String
  id              String           @id @default(uuid())
  postId          String
  post            SocialPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  status          PublishJobStatus @default(PENDING)
  attempts        Int              @default(0)
  lastError       String?
  nextAttemptAt   DateTime?
  externalPostUrl String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, nextAttemptAt])

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

enum RevenueStatus {
  PENDING
  CONFIRMED
  PAID
  REVERSED
}

model Revenue {
  workspaceId String
  id            String        @id @default(uuid())
  date          DateTime
  programId     String?
  program       AffiliateProgram? @relation(fields: [programId], references: [id])
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  campaignId    String?
  campaign      Campaign?     @relation(fields: [campaignId], references: [id])
  platform      String?
  grossAmount   Decimal       @db.Decimal(12, 2)
  currency      String        @default("EUR")
  status        RevenueStatus @default(PENDING)
  reference     String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([date])
  @@index([campaignId])

  @@index([workspaceId])
}

enum ExpenseCategory {
  TOOLS_SOFTWARE
  ADVERTISING
  AI_CREDITS
  VIDEO_PRODUCTION
  STOCK_MEDIA
  SUBSCRIPTIONS
  FREELANCE
  HARDWARE
  OFFICE
  TAXES_FEES
  OTHER
}

model Expense {
  workspaceId String
  id           String          @id @default(uuid())
  date         DateTime
  category     ExpenseCategory
  vendor       String?
  campaignId   String?
  campaign     Campaign?       @relation(fields: [campaignId], references: [id])
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id])
  amount       Decimal         @db.Decimal(12, 2)
  currency     String          @default("EUR")
  isRecurring  Boolean         @default(false)
  isTaxRelevant Boolean        @default(true)
  receiptUrl   String?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([date])
  @@index([campaignId])

  @@index([workspaceId])
}

model TaxSetting {
  workspaceId String
  id                    String   @id @default(uuid())
  reserveRatePercent    Decimal  @db.Decimal(5, 2) @default(30)
  vatRatePercent        Decimal  @db.Decimal(5, 2) @default(19)
  vatEnabled            Boolean  @default(false)
  tradeTaxReservePercent Decimal @db.Decimal(5, 2) @default(15)
  incomeTaxReservePercent Decimal @db.Decimal(5, 2) @default(25)
  updatedAt             DateTime @updatedAt

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Integrations / API vault
// ---------------------------------------------------------------------------

enum IntegrationCategory {
  AFFILIATE
  VIDEO
  AI
  SOCIAL_MEDIA
  ANALYTICS
  FINANCE
  STORAGE
}

model Integration {
  workspaceId String
  id            String              @id @default(uuid())
  providerKey   String
  displayName   String
  category      IntegrationCategory
  mode          IntegrationMode     @default(MOCK)
  status        String              @default("DISCONNECTED")
  lastSyncAt    DateTime?
  lastError     String?
  credentialId  String?
  credential    EncryptedCredential? @relation(fields: [credentialId], references: [id])
  config        Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([category])

  @@unique([workspaceId, providerKey])
  @@index([workspaceId])
}

model EncryptedCredential {
  workspaceId String
  id            String   @id @default(uuid())
  label         String
  cipherText    String
  iv            String
  authTag       String
  keyVersion    Int      @default(1)
  lastRotatedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  affiliatePrograms AffiliateProgram[]
  socialAccounts    SocialAccount[]
  integrations      Integration[]

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Agents & automations
// ---------------------------------------------------------------------------

enum AgentStatus {
  IDLE
  RUNNING
  PAUSED
  ERROR
}

model Agent {
  workspaceId String
  id             String      @id @default(uuid())
  key            String
  name           String
  role           String
  description    String
  capabilities   String[]    @default([])
  allowedActions String[]    @default([])
  status         AgentStatus @default(IDLE)
  lastRunAt      DateTime?
  nextTask       String?
  successCount   Int         @default(0)
  errorCount     Int         @default(0)
  config         Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  runs AgentRun[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

enum AgentRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model AgentRun {
  workspaceId String
  id         String         @id @default(uuid())
  agentId    String
  agent      Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status     AgentRunStatus @default(RUNNING)
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  summary    String?
  logs       Json?
  toolCalls  AgentToolCall[]

  @@index([agentId])

  @@index([workspaceId])
}

enum AutomationTrigger {
  PRODUCT_ADDED
  PRODUCT_SCORE_ABOVE_THRESHOLD
  SCRIPT_APPROVED
  VIDEO_COMPLETED
  POST_FAILED
  REVENUE_IMPORTED
  CAMPAIGN_UNDER_TARGET
  SCHEDULE_REACHED
}

enum AutomationActionType {
  CREATE_TASK
  GENERATE_SCRIPT
  PREPARE_VIDEO_JOB
  CREATE_NOTIFICATION
  CHANGE_STATUS
  PREPARE_PUBLISHING
  START_AGENT
  SEND_WEBHOOK
}

model Automation {
  workspaceId String
  id           String            @id @default(uuid())
  name         String
  isActive     Boolean           @default(true)
  trigger      AutomationTrigger
  conditions   Json?
  actions      Json
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  runs AutomationRun[]

  @@index([workspaceId])
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model AutomationRun {
  workspaceId String
  id           String               @id @default(uuid())
  automationId String
  automation   Automation           @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       AutomationRunStatus
  runAt        DateTime             @default(now())
  message      String?

  @@index([automationId])

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Notifications, contact, audit
// ---------------------------------------------------------------------------

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  workspaceId String
  id        String             @id @default(uuid())
  level     NotificationLevel  @default(INFO)
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([readAt])

  @@index([workspaceId])
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  handledAt DateTime?
}

model AuditLog {
  workspaceId String
  id         String   @id @default(uuid())
  actor      String   @default("owner")
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])

  @@index([workspaceId])
}

// ===========================================================================
// Phase 6 — Analytics, Content Intelligence, Experimentation, Optimization
// Single-user workspace: `workspaceId` is a required, indexed String used for
// isolation. Cross-references to pre-Phase-6 models (Product, Campaign,
// SocialPost, SocialAccount, MediaAsset, AffiliateProgram, AffiliateLink) are
// stored as scalar id columns and joined manually to avoid retrofitting
// back-relations onto those models.
// ===========================================================================

