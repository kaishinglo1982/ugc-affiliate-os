  status            ScaleGateStatus @default(PENDING)
  required          Boolean         @default(true)
  evidenceReference String?
  notes             String?
  checkedBy         String?
  checkedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, gateKey, regionCode])
  @@index([workspaceId, regionCode, status, required])
}
