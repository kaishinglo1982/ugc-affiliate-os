# Copy to `.env` in this directory and fill in every value. Never commit the
# real `.env` — it holds an OAuth client secret and the agent-server shared
# secret. `.env` is already covered by the repo-root .gitignore pattern for
# dotenv files; double-check before committing anything here.

# Public URL Woodpecker will be reachable at, no trailing slash. Must exactly
# match the OAuth App's callback URL below (see README.md, step 2).
WOODPECKER_HOST=https://ci.example.com

# From the GitHub OAuth App created in README.md step 2.
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# Your GitHub username. Only this account can administer the Woodpecker
# instance (WOODPECKER_OPEN=false in docker-compose.yml keeps it that way).
WOODPECKER_ADMIN=kaishinglo1982

# Shared secret between server and agent. Generate with:
#   openssl rand -hex 32
WOODPECKER_AGENT_SECRET=
