[Unit]
Description=UGC Affiliate OS - Phase 6 analytics automation pipeline (aggregate -> anomaly -> data-quality)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/ugc-affiliate-os
ExecStart=/usr/bin/env sh /srv/ugc-affiliate-os/scripts/run-analytics-cron.sh
EnvironmentFile=/srv/ugc-affiliate-os/.env
# Ensure WORKER_SECRET and APP_BASE_URL are present in the EnvironmentFile.
User=ugc_app
